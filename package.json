{
  "name": "aphw-ddi-enforcement",
  "version": "0.8.0",
  "description": "Web frontend for managing the dogs index",
  "homepage": "https://github.com/DEFRA/aphw-ddi-enforcement",
  "main": "app/index.js",
  "scripts": {
    "build": "webpack",
    "build:watch": "webpack --watch",
    "pretest": "npm run test:lint",
    "test": "jest --workerIdleMemoryLimit=512MB",
    "test:parallel": "jest",
    "test:unit": "jest --testPathPatterns=test/unit --coverage=false",
    "test:watch": "jest --coverage=false --watchAll",
    "test:watch:all": "npm-run-all --parallel test:watch build:watch",
    "test:lint": "standard",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "npm-run-all --parallel build:watch start:nodemon",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext css,js,njk --legacy-watch app/index.js",
    "start:nodemon": "nodemon --inspect=0.0.0.0 --ext css,js,njk --legacy-watch app/index.js"
  },
  "author": "Defra",
  "contributors": [],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.17.0",
    "@date-fns/utc": "^1.1.0",
    "@hapi/catbox": "^12.1.1",
    "@hapi/catbox-redis": "^7.1.0",
    "@hapi/cookie": "^12.0.1",
    "@hapi/crumb": "^9.0.1",
    "@hapi/hapi": "^21.4.10",
    "@hapi/hoek": "^11.0.7",
    "@hapi/inert": "^7.1.2",
    "@hapi/vision": "^7.0.3",
    "@hapi/wreck": "^18.1.0",
    "@hapi/yar": "^11.0.3",
    "accessible-autocomplete": "^2.0.4",
    "applicationinsights": "^3.16.0",
    "date-fns": "^3.2.0",
    "date-fns-tz": "^3.2.0",
    "ffc-messaging": "^2.10.10",
    "form-data": "^4.0.0",
    "friendly-challenge": "^0.9.13",
    "govuk-frontend": "^5.5.0",
    "hapi-pino": "^12.1.0",
    "joi": "^17.13.8",
    "jose": "^5.9.6",
    "jsdom": "^24.1.0",
    "jsonwebtoken": "^9.0.2",
    "nunjucks": "^3.2.4",
    "openid-client": "^5.6.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@hapi/catbox-memory": "^6.0.2",
    "@types/node": "^22.8.1",
    "blipp": "^4.0.2",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^5.2.6",
    "html-webpack-plugin": "^5.3.1",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "mini-css-extract-plugin": "^1.6.0",
    "nodemon": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.105.1",
    "sass-loader": "^11.1.1",
    "standard": "^17.1.2",
    "style-loader": "^2.0.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^4.10.0"
  },
  "standard": {
    "globals": [
      "describe",
      "beforeEach",
      "expect",
      "test",
      "afterEach",
      "jest",
      "beforeAll",
      "afterAll"
    ],
    "ignore": [
      "app/dist/**/*.js",
      "test/acceptance/**/*.js",
      "test/acceptance/**/*.mjs",
      "test/acceptance/**/*.cjs"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  },
  "overrides": {
    "uuid": "$uuid",
    "ffc-messaging": {
      "joi": "^18.3.1",
      "@azure/identity": "4.14.1"
    },
    "glob@^10": "^14.0.3",
    "glob@^13": "^14.0.3",
    "minimatch@^10": "^11.0.4"
  }
}